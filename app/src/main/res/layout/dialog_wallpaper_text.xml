<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/editWallpaperText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/custom_text_hint"
        android:maxLines="2"
        android:inputType="textCapSentences" />

    <TextView
        android:id="@+id/labelFontSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Font size: 24" />

    <!-- max = 40 - 12 = 28; SeekBar progress is offset by FONT_SIZE_MIN in code -->
    <SeekBar
        android:id="@+id/seekFontSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="28"
        android:progress="12" />

    <TextView
        android:id="@+id/labelDpi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Export DPI: 160" />

    <!-- 0-200, no offset needed -->
    <SeekBar
        android:id="@+id/seekDpi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200"
        android:progress="160" />

</LinearLayout>
