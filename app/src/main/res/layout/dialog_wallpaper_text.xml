<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/editWallpaperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_text_hint"
            android:maxLines="2"
            android:inputType="textCapSentences" />

        <TextView
            android:id="@+id/labelFontSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Font size: 40" />

        <!-- max = 60 - 30 = 30; SeekBar progress is offset by FONT_SIZE_MIN in code -->
        <SeekBar
            android:id="@+id/seekFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="10" />

        <TextView
            android:id="@+id/labelDpi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Export DPI: 135" />

        <!-- max = 170 - 120 = 50; SeekBar progress is offset by EXPORT_DPI_MIN in code -->
        <SeekBar
            android:id="@+id/seekDpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="@string/footer_copyright"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
